{
  "rewrites": [
    { "source": "/vatsim/data", "destination": "https://data.vatsim.net/v3/vatsim-data.json" },
    { "source": "/vatsim/events", "destination": "https://my.vatsim.net/api/v2/events/latest" },
    { "source": "/vatsim/bookings", "destination": "https://atc-bookings.vatsim.net/api/booking" },
    { "source": "/vatsim/metar/:id", "destination": "https://metar.vatsim.net/:id" }
  ],
  "headers": [
    { "source": "/vatsim/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
